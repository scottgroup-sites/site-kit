{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/tests/**)",
      "Edit(/site-kit.config.js)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/.gitattributes)",
      "Edit(/src/_headers)",
      "Edit(/eleventy.config.js)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Bash(git push origin {{productionBranch}}*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/node_modules/site-kit/bin/site-kit.mjs\" hook",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
